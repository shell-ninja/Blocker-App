{
  "compilerOptions": {
    "target": "esnext",
    "module": "commonjs",
    "lib": ["es2019"],
    "allowJs": true,
    "jsx": "react-native",
    "noEmit": true,
    "isolatedModules": true,
    "strict": false,
    "moduleResolution": "node",
    "baseUrl": ".",
    "typeRoots": [
      "/home/shell-ninja/Blocker/node_modules/@types"
    ],
    "paths": {
      "*": [
        "*",
        "/home/shell-ninja/Blocker/node_modules/*"
      ]
    },
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "source/src/**/*",
    "source/App.tsx"
  ]
}
